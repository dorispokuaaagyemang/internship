# Copy to .env (repo root). Used by the API in local dev and by docker compose.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Origin of the React app (Vite dev server locally, the public URL in production)
CORS_ORIGIN=http://localhost:5173

# MySQL. docker compose overrides DB_HOST to "mysql" inside the network.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship
DB_USER=internship
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# Hosted MySQL (e.g. Aiven) needs TLS: download the CA certificate, save it in the repo root
# (certs/ is gitignored) and set its path, relative to the repo root. Leave empty for local MySQL.
DB_SSL_CA=

# Redis. docker compose overrides this to redis://redis:6379.
# Hosted Redis (e.g. Upstash) uses TLS: paste its rediss://default:<password>@<host>:6379 URL.
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (SeaweedFS). docker compose overrides S3_ENDPOINT to http://seaweedfs:8333.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=internship
S3_SECRET_KEY=change-me-s3
S3_FORCE_PATH_STYLE=true
# Cloudflare R2 instead: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto, with an
# R2 API token that has Object Read & Write on both buckets (create the buckets in the dashboard first).
S3_BUCKET_RESUMES=resumes
S3_BUCKET_CERTIFICATES=certificates

# Auth sessions (ARCHITECTURE.md §4.1). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
# Defaults to true in production. The compose stack serves http on :80, so keep false there.
COOKIE_SECURE=false

# Public URL people open in the browser; email links start with it. Defaults to CORS_ORIGIN.
# Set it to http://localhost when using the full compose stack behind nginx.
APP_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24

# Google sign-in (US-00A). Create a "Web application" OAuth client in Google Cloud Console
# (APIs & Services > Credentials) and add APP_URL + /api/v1/auth/google/callback as an
# authorized redirect URI. Leave both empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to APP_URL + /api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=

# Outgoing email (Nodemailer). Leave SMTP_HOST empty to write emails to the worker log instead.
# `npm run infra:up` starts Mailpit: use SMTP_HOST=localhost, SMTP_PORT=1025, and read mail at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Internship Platform <no-reply@localhost>

