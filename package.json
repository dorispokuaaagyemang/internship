{
  "name": "internship-platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:worker": "npm run dev:worker -w server",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces",
    "build": "npm run build -w client",
    "infra:up": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d mysql redis seaweedfs mailpit",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down"
  }
}
