    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.14",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
